{
  "name": "react-portfolio-template",
  "version": "1.0.0",
  "description": "A data-driven developer portfolio template built with React, TypeScript, and Framer Motion. Fork, fill in your data, and deploy.",
  "type": "module",
  "homepage": "https://github.com/satishjhanwer/react-portfolio-template#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/satishjhanwer/react-portfolio-template.git"
  },
  "bugs": {
    "url": "https://github.com/satishjhanwer/react-portfolio-template/issues"
  },
  "keywords": [
    "portfolio",
    "template",
    "react",
    "typescript",
    "framer-motion",
    "vite",
    "developer-portfolio"
  ],
  "author": "Satish Jhanwer",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "icons": "node scripts/icons.ts",
    "prepare": "husky",
    "contact-files": "node scripts/contact-files.ts",
    "deploy": "node scripts/deploy.ts",
    "setup": "node scripts/setup.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "axe-core": "^4.14.0",
    "framer-motion": "^14.4.0",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "qrcode-generator": "^2.0.4",
    "satori": "^0.63.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "fflate": "^0.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "vitest related --run"
    ],
    "*.{css,json,md,html,yml,yaml,js,mjs}": "prettier --write"
  }
}
